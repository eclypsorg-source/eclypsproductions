  <script>
    document.documentElement.classList.add("js");
    const navbar = document.getElementById("navbar");
    const menuBtn = document.getElementById("menuBtn");
    const navLinks = document.getElementById("navLinks");

    window.addEventListener("scroll", () => {
      navbar.classList.toggle("scrolled", window.scrollY > 24);
    });

    menuBtn.addEventListener("click", () => {
      const isOpen = navLinks.classList.toggle("open");
      menuBtn.setAttribute("aria-expanded", String(isOpen));
      menuBtn.textContent = isOpen ? "×" : "☰";
    });

    navLinks.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", () => {
        navLinks.classList.remove("open");
        menuBtn.setAttribute("aria-expanded", "false");
        menuBtn.textContent = "☰";
      });
    });

    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });

    document.querySelectorAll(".reveal").forEach(element => observer.observe(element));
    document.getElementById("year").textContent = new Date().getFullYear();
  </script>

  <script>
    // Normativa: acordeones accesibles, búsqueda en vivo e índice interactivo.
    (() => {
      const cards = [...document.querySelectorAll('.rule-card')];
      const search = document.getElementById('ruleSearch');
      const expand = document.getElementById('expandRules');
      const toggles = document.querySelectorAll('.rule-toggle');
      toggles.forEach(btn => btn.addEventListener('click', () => {
        const card = btn.closest('.rule-card');
        const content = card.querySelector('.rule-content');
        const opening = !card.classList.contains('open');
        card.classList.toggle('open', opening);
        btn.setAttribute('aria-expanded', String(opening));
        content.hidden = !opening;
      }));
      if (expand) expand.addEventListener('click', () => {
        const shouldOpen = cards.some(c => !c.classList.contains('open') && !c.hidden);
        cards.forEach(card => {
          if (card.hidden) return;
          card.classList.toggle('open', shouldOpen);
          card.querySelector('.rule-toggle').setAttribute('aria-expanded', String(shouldOpen));
          card.querySelector('.rule-content').hidden = !shouldOpen;
        });
        expand.innerHTML = shouldOpen ? 'Contraer todo <span>−</span>' : 'Expandir todo <span>＋</span>';
      });
      if (search) search.addEventListener('input', () => {
        const q = search.value.trim().toLocaleLowerCase('es');
        cards.forEach(card => {
          const match = !q || (card.dataset.search || '').includes(q);
          card.hidden = !match;
          if (q && match) {
            card.classList.add('open');
            card.querySelector('.rule-toggle').setAttribute('aria-expanded','true');
            card.querySelector('.rule-content').hidden = false;
          } else if (!q) {
            card.classList.remove('open');
            card.querySelector('.rule-toggle').setAttribute('aria-expanded','false');
            card.querySelector('.rule-content').hidden = true;
          }
        });
      });
      document.addEventListener('keydown', e => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault(); search?.focus();
        }
      });
      document.querySelectorAll('.rules-aside a').forEach(link => link.addEventListener('click', () => {
        document.querySelectorAll('.rules-aside a').forEach(a => a.classList.remove('active'));
        link.classList.add('active');
      }));
    })();
  </script>

